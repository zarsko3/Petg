{
    "configurations": [
        {
            "name": "ESP32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/firmware/ESP32-S3_PetCollar/**",
                "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/3.2.0/**",
                "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/tools/**",
                "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/3.2.0/cores/esp32",
                "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/3.2.0/tools/sdk/include",
                "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/3.2.0/variants/esp32s3",
                "${env:USERPROFILE}/Documents/Arduino/libraries/**",
                "${env:USERPROFILE}/Documents/Arduino/libraries/WebSockets/src",
                "${env:USERPROFILE}/Documents/Arduino/libraries/ArduinoJson/src",
                "${env:USERPROFILE}/Documents/Arduino/libraries/PubSubClient/src",
                "${env:USERPROFILE}/Documents/Arduino/libraries/Adafruit_SSD1306",
                "${env:USERPROFILE}/Documents/Arduino/libraries/Adafruit_GFX_Library",
                "${env:USERPROFILE}/Documents/Arduino/libraries/Adafruit_BusIO",
                "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/3.2.0/libraries/**"
            ],
            "browse": {
                "limitSymbolsToIncludedHeaders": false,
                "path": [
                    "${workspaceFolder}/**",
                    "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/hardware/esp32/3.2.0/**",
                    "${env:USERPROFILE}/Documents/Arduino/libraries/**"
                ]
            },
            "defines": [
                "ESP32=1",
                "ESP_PLATFORM=1",
                "ARDUINO=10800",
                "ARDUINO_ESP32_DEV",
                "ARDUINO_ARCH_ESP32",
                "ARDUINO_BOARD=\"ESP32S3_DEV\"",
                "ARDUINO_VARIANT=\"esp32s3\"",
                "F_CPU=240000000L"
            ],
            "compilerPath": "${env:USERPROFILE}/AppData/Local/Arduino15/packages/esp32/tools/esp-x32/2411/bin/xtensa-esp32s3-elf-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}